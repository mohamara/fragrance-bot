# ============================================
# تنظیمات Production - ربات مشاور عطر هوشمند
# ============================================

# ============================================
# OpenAI Configuration
# ============================================
# کلید API از OpenAI (الزامی)
# دریافت از: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# مدل OpenAI (پیش‌فرض: gpt-4o-mini)
# گزینه‌های پیشنهادی: gpt-4o-mini, gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# درجه خلاقیت پاسخ‌ها (0 تا 1)
# 0 = دقیق و قابل پیش‌بینی، 1 = خلاق و متنوع
# پیش‌فرض: 0.7
TEMPERATURE=0.7

# حداکثر طول پاسخ (تعداد توکن)
# پیش‌فرض: 2000
MAX_TOKENS=2000

# ============================================
# Telegram Bot Configuration
# ============================================
# توکن ربات تلگرام (الزامی)
# دریافت از: @BotFather در تلگرام
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# Database Configuration
# ============================================
# مسیر فایل پایگاه داده SQLite
# در Docker: /app/data/chatbot.db
# در حالت عادی: ./data/chatbot.db
DB_PATH=/app/data/chatbot.db

# ============================================
# Knowledge Base Configuration
# ============================================
# مسیر پوشه پایگاه دانش
# در Docker: /app/knowledge_base
# در حالت عادی: ./knowledge_base
KNOWLEDGE_BASE_PATH=/app/knowledge_base

# ============================================
# Environment
# ============================================
NODE_ENV=production

